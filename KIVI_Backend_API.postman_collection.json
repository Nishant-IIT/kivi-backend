                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"phone\": \"{{phone}}\",\n  \"metadata\": {\n    \"name\": \"Rahul Sharma\",\n    \"job\": \"Delivery Partner\",\n    \"gig_platforms\": [\"Swiggy\", \"Zomato\"],\n    \"transaction_summary\": {\n      \"balance\": 12000.00,\n      \"monthly_spending\": 8500.00,\n      \"monthly_income\": 28000.00\n    }\n  },\n  \"message\": \"How much did I spend on food this month?\",\n  \"provider\": \"openai\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/ai/chat",
                            "host": [
