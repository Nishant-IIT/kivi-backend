{
    "info": {
        "_postman_id": "kivi-backend-api-2025",
        "name": "KIVI Backend API",
        "description": "Complete API collection for KIVI Backend - AI-powered financial management platform for gig workers.\n\nFeatures:\n- WhatsApp integration\n- AI chat (OpenAI, Anthropic)\n- SMS transaction parsing\n- Financial dashboard and reports\n- User profile management\n- Proactive notifications",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.environment.set(\"access_token\", jsonData.access_token);",
                                    "    pm.environment.set(\"user_id\", jsonData.user_id);",
                                    "    pm.environment.set(\"phone\", jsonData.phone);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"+919876543210\",\n  \"password\": \"demo123\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        },
                        "description": "Authenticate user and receive JWT access token.\n\nFor hackathon/demo: Use password \"demo123\" for any phone number.\nFirst-time users are automatically onboarded with sample gig worker data."
                    },
                    "response": []
                }
            ],
            "description": "Authentication endpoints for user login and JWT token generation."
        },
        {
            "name": "User Profile",
            "item": [
                {
                    "name": "Get User Profile",
                    "request": {
                        "method": "GET",
