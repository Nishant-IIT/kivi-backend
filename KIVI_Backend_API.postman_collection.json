            "description": "Financial transaction management, SMS parsing, dashboard, and reporting endpoints."
        },
        {
            "name": "WhatsApp Integration",
            "item": [
                {
                    "name": "WhatsApp Webhook",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"123456789\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"919876543210\",\n              \"phone_number_id\": \"123456789\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Rahul Sharma\"\n                },\n                \"wa_id\": \"919876543210\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"919876543210\",\n                \"id\": \"wamid.HBgNOTE5ODc2NTQzMjEwFQIAERgSMDhBRjE2QjdGNzY4QzQ5OTJBAA==\",\n                \"timestamp\": \"1706123456\",\n                \"text\": {\n                  \"body\": \"How much did I spend on food this month?\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/whatsapp/webhook",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "whatsapp",
                                "webhook"
                            ]
                        },
                        "description": "Receive incoming WhatsApp messages from Meta Cloud API. This endpoint is called by Meta, not directly by users. Returns 200 OK immediately and processes message in background."
                    },
                    "response": []
                },
                {
                    "name": "Send Notification",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"phone\": \"+919876543210\",\n  \"text\": \"You've exceeded your food budget by ₹200 this month. Consider cooking at home more often!\",\n  \"provider\": \"openai\"\n}"
                        },
                        "url": {
                            "raw": "{{base_url}}/api/v1/whatsapp/send_notification",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "whatsapp",
                                "send_notification"
                            ]
                        },
                        "description": "Send proactive WhatsApp notification to user. Used for budget alerts, spending insights, and other notifications."
                    },
                    "response": []
                }
            ],
            "description": "WhatsApp webhook and notification endpoints for Meta Cloud API integration."
        },
        {
            "name": "AI Chat",
            "item": [
